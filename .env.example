# Copy to .env. Do not commit secrets.

# Pipecat pipeline. OPENAI_API_KEY is required.
# Use a Scalekit LLM gateway key with OPENAI_BASE_URL, or a real OpenAI key.
# Deepgram + Cartesia are optional. Without them the bot uses local Whisper + Kokoro.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://llm.scalekit.cloud/v1
OPENAI_MODEL=claude-haiku-4-5
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# Scalekit AgentKit (server only)
SCALEKIT_ENV_URL=https://your-env.scalekit.com
SCALEKIT_CLIENT_ID=skc_
SCALEKIT_CLIENT_SECRET=skcs_

# Must match an ACTIVE Google Calendar connected account in AgentKit.
TEST_IDENTIFIER=you@example.com

# Connection name from Scalekit Dashboard → AgentKit → Connections.
SCALEKIT_CONNECTION_NAME=googlecalendar

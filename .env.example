# Copy to .env. Do not commit secrets.

# Scalekit AgentKit (server only)
SCALEKIT_ENV_URL=https://your-env.scalekit.com
SCALEKIT_CLIENT_ID=skc_
SCALEKIT_CLIENT_SECRET=skcs_

# Your connected-account identifier from the Scalekit dashboard.
CONNECTED_ACCOUNT_ID=you@example.com

# Connection name from Scalekit Dashboard → AgentKit → Connections.
SCALEKIT_CONNECTION_NAME=googlecalendar

# Real OpenAI key. Same as the Pipecat quickstart.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Speech. Required. Same as the Pipecat quickstart.
# Deepgram: https://console.deepgram.com/signup
# Cartesia: https://play.cartesia.ai
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
